# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > App da Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pública usada nos QR Codes (ex.: https://reverse-motor.vercel.app ou http://192.168.0.10:3000).
# Se vazio, usa a origem atual do navegador (cuidado: "localhost" não funciona no celular).
NEXT_PUBLIC_APP_URL=
